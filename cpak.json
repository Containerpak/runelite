{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "RuneLite",
  "description": "Play Old School RuneScape with RuneLite.",
  "version": "2.8.0",
  "image": "ghcr.io/containerpak/runelite@sha256:83d34641d92d84e1b3be4420aab9b32e2b1c1f54890d5db8d43bc9369659cf80",
  "binaries": [
    "/usr/bin/runelite"
  ],
  "desktop_entries": [
    "/usr/share/applications/net.runelite.RuneLite.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": true,
    "clipboard": {
      "hostToApp": true,
      "appToHost": true
    },
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [
      "LIBGL_ALWAYS_SOFTWARE=1"
    ],
    "network": true,
    "process": false,
    "userNamespaces": true,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
